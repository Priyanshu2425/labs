# =============================================================================
# Contact form notification channels
# -----------------------------------------------------------------------------
# Configure at least ONE channel below so /api/contact can deliver submissions.
# Channels fan out in parallel — set as many as you want. The form succeeds if
# ANY configured channel succeeds.
# =============================================================================

# Slack — easiest. Create an Incoming Webhook in your workspace:
#   https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=<your-slack-incoming-webhook-url>

# Discord — comparable. Channel Settings → Integrations → Webhooks → New.
# DISCORD_WEBHOOK_URL=<your-discord-webhook-url>

# Email via Resend (resend.com). Free tier: 100 emails/day, 3K/month.
# 1. Create an account, get an API key from the dashboard.
# 2. Either verify your sending domain OR keep CONTACT_EMAIL_FROM unset to use
#    the default `onboarding@resend.dev` (only delivers to YOUR own address).
# 3. CONTACT_EMAIL_TO is where notifications land.
# RESEND_API_KEY=<your-resend-api-key>
# CONTACT_EMAIL_TO=aryan@vruoom.com
# CONTACT_EMAIL_FROM=contact@buildspacelabs.com   # optional, defaults to onboarding@resend.dev

# =============================================================================
# /offer page — AI scoping funnel + DeepSeek offer engine
# =============================================================================

# OpenRouter — powers the /get-offer analysis (runs the Buildspace strategist
# prompt on the audit the user pastes back). Create a key at openrouter.ai.
# OPENROUTER_API_KEY=<your-openrouter-api-key>
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1   # optional; swap the DeepSeek slug without a code change

# Resend Audience — the /offer email gate adds captured emails to this mailing
# list (reuses RESEND_API_KEY above). Create an Audience in the Resend dashboard
# and copy its ID. Without this, emails still ping your notification channels.
# RESEND_AUDIENCE_ID=<your-resend-audience-id>

# Cloudflare Turnstile — bot gate on the paid /api/offer analyze call. Create a
# widget at dash.cloudflare.com → Turnstile. When unset, the widget and server
# verification are both skipped (fine for dev; leaves prod's LLM endpoint open).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<your-turnstile-site-key>   # public, ships to the browser
# TURNSTILE_SECRET_KEY=<your-turnstile-secret-key>          # server-only, never expose

# =============================================================================
# Analytics & Search Console (SEO / monitoring — Phase 6)
# -----------------------------------------------------------------------------
# Both are DORMANT until set: leave unset in dev and nothing renders. Fill in
# after choosing an analytics tool and verifying the site in Search Console.
# =============================================================================

# Google Analytics 4 — create a property at analytics.google.com, copy the
# Measurement ID. When set, the gtag snippet mounts; when unset, no tag ships.
# (Alternatives that need NO code: Cloudflare Web Analytics dashboard toggle,
#  or Plausible — pick one; don't run several.)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console verification — only needed if verifying via the HTML
# meta tag instead of a DNS TXT record. Paste just the token (the value of the
# `content` attribute), not the whole tag. Prefer DNS TXT if you control DNS.
# NEXT_PUBLIC_GSC_VERIFICATION=<google-site-verification-token>
